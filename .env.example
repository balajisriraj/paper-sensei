# Claude (default). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
PAPERSENSEI_LLM=anthropic
PAPERSENSEI_MODEL=claude-opus-5-5

# Run with no API key: a deterministic model that teaches extractively from the paper's own sentences.
# PAPERSENSEI_LLM=scripted
# PAPERSENSEI_SCRIPTED_DELAY=0.03
